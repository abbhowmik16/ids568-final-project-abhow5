{
  "title": "IDS568 Final Project RAG Monitoring Dashboard",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Total RAG Requests",
      "targets": [
        {
          "expr": "sum(rag_requests_total)",
          "legendFormat": "requests"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "timeseries",
      "title": "End-to-End Latency p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(rag_request_latency_seconds_bucket[5m]))",
          "legendFormat": "p95 latency"
        }
      ],
      "gridPos": {"x": 6, "y": 0, "w": 9, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "Retrieval Latency p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(rag_retrieval_latency_seconds_bucket[5m]))",
          "legendFormat": "retrieval p95"
        }
      ],
      "gridPos": {"x": 15, "y": 0, "w": 9, "h": 6}
    },
    {
      "type": "gauge",
      "title": "Average Retrieval Distance",
      "targets": [
        {
          "expr": "rag_average_retrieval_distance",
          "legendFormat": "distance"
        }
      ],
      "gridPos": {"x": 0, "y": 6, "w": 6, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "Retrieved Chunk Count",
      "targets": [
        {
          "expr": "rate(rag_retrieval_result_count_sum[5m]) / rate(rag_retrieval_result_count_count[5m])",
          "legendFormat": "avg chunks"
        }
      ],
      "gridPos": {"x": 6, "y": 6, "w": 9, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "Response Length",
      "targets": [
        {
          "expr": "rate(rag_response_length_chars_sum[5m]) / rate(rag_response_length_chars_count[5m])",
          "legendFormat": "avg chars"
        }
      ],
      "gridPos": {"x": 15, "y": 6, "w": 9, "h": 6}
    }
  ]
}